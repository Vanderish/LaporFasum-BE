# Proyek Pelaporan Fasilitas Umum Kabupaten Lamongan
# Salin file ini menjadi .env dan isi nilai yang sesuai

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Mapbox Configuration
BOUNDINGBOX=112.0725631,-7.3847412,112.5523757,-6.8611266

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pelaporan
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# JWT Secrets (generate dengan: openssl rand -hex 64)
USER_SECRET=generate_random_hex_64_characters_here
ADMIN_KEC_SECRET=generate_random_hex_64_characters_here  
ADMIN_KAB_SECRET=generate_random_hex_64_characters_here

# External APIs
OVERPASS_URL=https://lz4.overpass-api.de/api/interpreter

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret